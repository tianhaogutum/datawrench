{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Standalone semantic diff validation result v1",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "diff_validation_version": {
          "type": "integer",
          "const": 1
        },
        "valid": {
          "const": true
        },
        "diagnostics": {
          "type": "array",
          "maxItems": 0
        }
      },
      "required": [
        "diff_validation_version",
        "valid",
        "diagnostics"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "diff_validation_version": {
          "type": "integer",
          "const": 1
        },
        "valid": {
          "const": false
        },
        "diagnostics": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "const": "$"
              },
              "rule": {
                "const": "invalid_diff"
              }
            },
            "required": [
              "path",
              "rule"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "diff_validation_version",
        "valid",
        "diagnostics"
      ],
      "additionalProperties": false
    }
  ]
}
