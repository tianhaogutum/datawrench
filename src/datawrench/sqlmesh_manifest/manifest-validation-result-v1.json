{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Standalone manifest validation result v1",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "manifest_validation_version": {
          "type": "integer",
          "const": 1
        },
        "valid": {
          "const": true
        },
        "manifest_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12
        },
        "counts": {
          "type": "object",
          "properties": {
            "resources": {
              "type": "integer",
              "minimum": 0
            },
            "models": {
              "type": "integer",
              "minimum": 0
            },
            "seeds": {
              "type": "integer",
              "minimum": 0
            },
            "sources": {
              "type": "integer",
              "minimum": 0
            },
            "tests": {
              "type": "integer",
              "minimum": 0
            },
            "edges": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "resources",
            "models",
            "seeds",
            "sources",
            "tests",
            "edges"
          ],
          "additionalProperties": false
        },
        "diagnostics": {
          "type": "array",
          "maxItems": 0
        }
      },
      "required": [
        "manifest_validation_version",
        "valid",
        "manifest_version",
        "counts",
        "diagnostics"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "manifest_validation_version": {
          "type": "integer",
          "const": 1
        },
        "valid": {
          "const": false
        },
        "manifest_version": {
          "type": "null"
        },
        "counts": {
          "type": "null"
        },
        "diagnostics": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "path": {
                    "const": "$"
                  },
                  "rule": {
                    "const": "read_json"
                  }
                },
                "required": [
                  "path",
                  "rule"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "path": {
                    "const": "$.metadata.dbt_schema_version"
                  },
                  "rule": {
                    "const": "manifest_version"
                  }
                },
                "required": [
                  "path",
                  "rule"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "path": {
                    "const": "$"
                  },
                  "rule": {
                    "const": "schema_validation"
                  }
                },
                "required": [
                  "path",
                  "rule"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "path": {
                    "const": "$"
                  },
                  "rule": {
                    "const": "parser_validation"
                  }
                },
                "required": [
                  "path",
                  "rule"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "path": {
                    "const": "$"
                  },
                  "rule": {
                    "const": "graph_validation"
                  }
                },
                "required": [
                  "path",
                  "rule"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "path": {
                    "const": "$"
                  },
                  "rule": {
                    "const": "internal_error"
                  }
                },
                "required": [
                  "path",
                  "rule"
                ],
                "additionalProperties": false
              }
            ]
          }
        }
      },
      "required": [
        "manifest_validation_version",
        "valid",
        "manifest_version",
        "counts",
        "diagnostics"
      ],
      "additionalProperties": false
    }
  ]
}
