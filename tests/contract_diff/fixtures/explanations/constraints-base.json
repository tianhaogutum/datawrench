{
  "metadata": {
    "dbt_schema_version": "https://schemas.getdbt.com/dbt/manifest/v12.json",
    "project_id": "synthetic-shop",
    "adapter_type": "duckdb"
  },
  "nodes": {
    "model.shop.orders": {
      "unique_id": "model.shop.orders",
      "resource_type": "model",
      "package_name": "shop",
      "name": "orders",
      "config": {
        "enabled": true
      },
      "contract": {
        "enforced": true
      },
      "columns": {
        "id": {
          "name": "id",
          "data_type": "INT",
          "constraints": []
        },
        "payload": {
          "name": "payload",
          "data_type": "STRUCT(items ARRAY(STRUCT(amount INT)))",
          "constraints": [
            {
              "type": "check",
              "expression": "payload.items[1].amount >= 0"
            }
          ]
        }
      },
      "constraints": [
        {
          "type": "unique",
          "columns": [
            "id",
            "payload"
          ]
        }
      ]
    }
  },
  "disabled": {}
}
